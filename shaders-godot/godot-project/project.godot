; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="walstad loom"
config/description="Generative pixel-art Walstad aquarium. 3D voxel content rendered through palette-quantized 512x288 SubViewport."
config/version="0.2.31"
run/main_scene="res://tank_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.png"

[autoload]

AppLog="*res://scripts/app_log.gd"
Localization="*res://scripts/localization.gd"
TankSaves="*res://scripts/tank_saves.gd"
TankConfig="*res://scripts/tank_config.gd"
SpeciesLibrary="*res://scripts/species_library.gd"
SteamService="*res://scripts/steam_service.gd"
AIDirector="*res://scripts/ai_director.gd"
GuardianLlm="*res://scripts/guardian_llm.gd"
MusicContext="*res://scripts/music_context.gd"
UiTicker="*res://scripts/ui_ticker.gd"
GamepadInput="*res://scripts/gamepad_input.gd"

[display]

window/size/viewport_width=1536
window/size/viewport_height=864
window/stretch/mode="viewport"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/theme/walstad_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
renderer/rendering_method.web="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.07, 1)
occlusion_culling/use_occlusion_culling=true
2d/snap/snap_2d_transforms_to_pixel=true

[shader_globals]

iaq_beam_origin={
"type": "vec3",
"value": Vector3(0, 999, 0)
}
iaq_beam_dir={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
iaq_beam_cone={
"type": "vec4",
"value": Vector4(-1, -1, 30, 0)
}
iaq_beam_tint={
"type": "vec4",
"value": Vector4(1, 0.9, 0.7, 1)
}
iaq_beam_axis={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
iaq_occluder_tex={
"type": "sampler2D",
"value": ""
}
iaq_occluder_info={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
iaq_water_depth={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
iaq_palette_fauna={
"type": "vec4",
"value": Vector4(0, 1, 0, 1)
}
iaq_palette_foliage={
"type": "vec4",
"value": Vector4(0, 1, 0, 1)
}
iaq_palette_hardscape={
"type": "vec4",
"value": Vector4(0, 1, 0, 1)
}
iaq_palette_substrate={
"type": "vec4",
"value": Vector4(0, 1, 0, 1)
}
iaq_palette_water={
"type": "vec4",
"value": Vector4(0, 1, 0, 1)
}
iaq_water_absorb={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
iaq_water_body={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[steam]

initialization/app_id=4796460
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
