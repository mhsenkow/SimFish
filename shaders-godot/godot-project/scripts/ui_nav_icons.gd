static func has(id: String) -> bool:
	return _PATTERNS.has(id)


static func texture(id: String) -> Texture2D:
	if _cache.has(id):
		return _cache[id] as Texture2D
	if not _PATTERNS.has(id):
		return null
	var rows: Array = _PATTERNS[id]
	var n: int = rows.size()
	var img := Image.create(n, n, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in n:
		var row: String = String(rows[y])
		var w: int = mini(n, row.length())
		for x in w:
			if row.unicode_at(x) == 35:
				img.set_pixel(x, y, Color(1, 1, 1, 1))
	if _SCALE > 1:
		img.resize(n * _SCALE, n * _SCALE, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(img)
	_cache[id] = tex
	return tex


static func apply(btn: Button, id: String, tint: Color = Color(0.93, 0.95, 0.98, 1)) -> void:
	var tex := texture(id)
	if btn == null or tex == null:
		return
	btn.text = ""
	btn.icon = tex
	btn.expand_icon = true
	btn.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	btn.vertical_icon_alignment = VERTICAL_ALIGNMENT_CENTER
	btn.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var edge: float = btn.custom_minimum_size.x
	if edge < 8.0:
		edge = btn.custom_minimum_size.y
	if edge < 8.0:
		edge = 48.0
	btn.add_theme_constant_override("icon_max_width", int(round(edge * 0.58)))
	btn.add_theme_color_override("icon_normal_color", tint)
	btn.add_theme_color_override("icon_hover_color", Color.WHITE)
	btn.add_theme_color_override("icon_pressed_color", Color.WHITE)
	btn.add_theme_color_override("icon_focus_color", Color.WHITE)
	btn.add_theme_color_override("icon_disabled_color", Color(tint.r, tint.g, tint.b, 0.35))

