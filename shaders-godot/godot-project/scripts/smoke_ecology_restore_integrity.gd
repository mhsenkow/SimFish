extends SceneTree
const Store = preload("res://scripts/substrate_allelopathy_store.gd")

func _initialize() -> void:
	await process_frame
	var t := TestSupport.Suite.new("smoke_ecology_restore_integrity")
	root.get_node("TankConfig").capture_mode = true
	var store = Store.new()
	store.init(2, 2)
	store.add(Vector2i.ZERO, "a", 0.2)
	store.add(Vector2i.ZERO, "b", 0.1)
	var saved: Array = store.to_sparse_save()
	store.apply_sparse_save(saved)
	store.apply_sparse_save(saved)
	t.approx(store.total(Vector2i.ZERO), 0.3, "repeated restores cannot amplify chemical pressure")
	t.approx(store.pressure(Vector2i.ZERO, "a", 0.0), 0.13, "restored kin resistance remains intact")
	store.apply_sparse_save([])
	t.approx(store.total(Vector2i.ZERO), 0.0, "empty restore removes old chemical families")
	t.approx(store.add(Vector2i(-1, 0), "bad", 0.2), 0.0, "invalid emission cells are safe")
	t.approx(store.total(Vector2i(9, 9)), 0.0, "invalid totals are safe")
	t.check(store.mix_at(Vector2i(9, 9)).is_empty(), "invalid mixtures are safe")
	t.approx(store.add(Vector2i.ZERO, "bad", NAN), 0.0, "nonfinite emissions are rejected")
	store.apply_sparse_save([{"x": "oops", "z": 0, "mix": {"bad": 0.2}},
		{"x": 0, "z": 0, "mix": {"bad": "oops", "a": 0.2}}])
	t.approx(store.total(Vector2i.ZERO), 0.2, "malformed saved values cannot poison the field")
	store.tick_cells([Vector2i.ZERO, Vector2i(-1, 0)], NAN)
	t.approx(store.total(Vector2i.ZERO), 0.2, "nonfinite elapsed time leaves chemistry intact")
	store.tick_cells([Vector2i.ZERO, Vector2i(-1, 0)], 1.0)
	t.approx(store.total(Vector2i.ZERO), 0.192, "valid cells still decay despite an invalid cell")
	store.apply_sparse_save([])
	for i in 20:
		store.add(Vector2i.ZERO, "family:%d" % i, 0.02)
	var measured: float = 0.0
	for amount in store.mix_at(Vector2i.ZERO).values():
		measured += float(amount)
	t.approx(store.total(Vector2i.ZERO), measured, "cached total preserves mass through family eviction")
	store.tick_cells([Vector2i.ZERO], 1000.0)
	t.approx(store.total(Vector2i.ZERO), 0.0, "complete decay clears the cached total")
	store.init(2, 2)
	t.approx(store.total(Vector2i.ZERO), 0.0, "reinitializing resets cached concentration")
	var grid := SubstrateGrid.new()
	grid.init(1.0, 1.0)
	var empty: Dictionary = grid.to_save_dict()
	grid.add_family_allelochemical_at(Vector3.ZERO, "old", 0.5)
	grid.apply_save_dict(empty)
	t.approx(grid.get_allelochemical_at(Vector3.ZERO), 0.0, "empty grid save clears old chemistry")
	grid.add_family_allelochemical_at(Vector3.ZERO, "kin", 0.3)
	var full: Dictionary = grid.to_save_dict()
	grid.apply_save_dict(full)
	grid.apply_save_dict(full)
	t.approx(grid.get_allelochemical_at(Vector3.ZERO), 0.3, "grid restore is idempotent")
	full.erase("allelopathy_families")
	grid.apply_save_dict(full)
	grid.apply_save_dict(full)
	t.approx(grid.get_allelochemical_at(Vector3.ZERO), 0.3, "legacy chemistry migration is idempotent")
	t.check(grid.get_allelopathy_mix_at(Vector3.ZERO).has("legacy:anonymous"), "legacy migration replaces previous family identity")
	grid.free()
	var sim := SimDriver.new()
	for radius in [-1.0, NAN, INF]:
		t.check(sim.query_fish_in_radius(Vector3.ZERO, radius).is_empty(), "invalid fish-query radius is safe")
		t.check(sim.query_plants_in_radius(Vector3.ZERO, radius).is_empty(), "invalid plant-query radius is safe")
		t.check(sim.query_snails_in_radius(Vector3.ZERO, radius).is_empty(), "invalid snail-query radius is safe")
	var fish := Fish.new()
	root.add_child(fish)
	fish.set_process(false)
	fish.position = Vector3(1, 0, 0)
	sim.fish.append(fish)
	t.equals(sim.query_fish_in_radius(Vector3.ZERO, 4.0), [fish], "fish search preserves a live neighbour")
	t.check(sim.query_fish_in_radius(Vector3.ZERO, 0.5).is_empty(), "fish search still enforces exact distance")
	sim.fish.clear()
	t.check(sim.query_fish_in_radius(Vector3.ZERO, 4.0).is_empty(), "cleared inventory cannot return stale grid fish")
	sim.free()
	fish.queue_free()
	await process_frame
	quit(t.finish())
